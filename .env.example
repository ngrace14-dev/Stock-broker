# Alpaca Markets API Credentials
# Use https://paper-api.alpaca.markets for free Paper Trading
# Use https://api.alpaca.markets for Live Trading
ALPACA_API_KEY=YOUR_ALPACA_API_KEY_HERE
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_KEY_HERE
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER=true

# Optional Gemini API Key (for AI Signal / Market Commentary or Crypto Extensions)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Web Wrapper Viewport Server Settings
HOST=127.0.0.1
PORT=8000

# Remote Tunnel Personal Password Gate (Beta Testing)
# When set, all web dashboard and API requests require this password
REMOTE_AUTH_USER=commander
REMOTE_AUTH_PASS=YOUR_PERSONAL_BETA_PASSWORD_HERE
